# ROYA — AI Film Production Manager
# All keys are OPTIONAL — the app runs with mock data when keys are missing.

# OpenAI API Key (for GPT-4o-mini screenplay analysis)
# If missing, analyze_script returns pre-extracted demo scenes
OPENAI_API_KEY=

# OpenWeatherMap API Key (for real weather forecasts)
# If missing, generate_schedule uses mock weather data
OPENWEATHER_API_KEY=

# Base URL for the app (used in call sheets)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
